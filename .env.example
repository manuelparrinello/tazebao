SECRET_KEY=
EMAIL_CREDENTIALS_KEY=
FLASK_ENV=development

# Root filesystem per cartelle cliente/lavoro
# Può essere path locale o mount di rete
ERP_STORAGE_ROOT=./storage

# Limite upload file in MB (default: 512)
ERP_MAX_UPLOAD_MB=512

# Limite memoria form non-file in MB (default: 5)
# Werkzeug 3.1+ impone limite 500KB di default; qui puoi alzarlo
ERP_MAX_FORM_MEMORY_MB=5
